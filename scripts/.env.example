# nk-work-kit — one config file for every skill in the plugin.
#
#   cp scripts/.env.example ~/.config/nk-work-kit/.env
#   chmod 600 ~/.config/nk-work-kit/.env
#
# Keep it in ~/.config: a plugin is installed into a version-pinned directory
# (~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/), so a .env left
# beside the scripts is orphaned by the next plugin upgrade. A .env next to
# the scripts still works as a fallback, e.g. when running from a clone.
#
# Not covered here: the doc-number skill keeps a signed-in Chromium profile at
# ~/.local/share/buu-docnum/profile — no credentials, and it already lives
# outside the plugin, so upgrades leave it alone.

# transcribe skill
OPENROUTER_API_KEY=sk-or-v1-...
# After a transcription, the audio file and its .md transcript are MOVED here
# with rclone. An rclone remote:path, e.g. GDrive:Recordings. Leave empty to be
# asked on the next run; set to none to keep both local.
TRANSCRIBE_RCLONE_DEST=

# pending-docs skill — BUU eDoc (https://doc.buu.ac.th/docweb/v2/)
# No inline comments after a value: the whole line after "=" is the value.
EDOC_USERNAME=
EDOC_PASSWORD=
# Optional. Comma-separated inbox names to check, e.g. "ผศ. ดร. ... ,คณะวิศวกรรมศาสตร์".
# Leave EMPTY to check every inbox the account has — recommended, since a name
# that no longer matches is reported as an error rather than hiding an inbox.
EDOC_INBOX=

# edoc-digest skill — reuses EDOC_USERNAME / EDOC_PASSWORD above.
# Comma-separated inbox names to fetch, analyse and ลงรับ. Required: there is no
# "all inboxes" default, because this skill writes (ลงรับ) to eDoc.
EDOC_DIGEST_INBOX=

# pending-docs skill — BUU e-Signature (https://e-sign.buu.ac.th)
# Leave blank to reuse EDOC_USERNAME / EDOC_PASSWORD.
ESIGN_USERNAME=
ESIGN_PASSWORD=

# project-manager skill — Obsidian vault (the folder that contains .obsidian/)
OBSIDIAN_VAULT=
# Optional: folder for hub notes + Dashboard.md (default Projects), day windows.
PM_FOLDER=Projects
# Vault name used in obsidian:// links (default: the vault folder's name). Set it
# on a server whose copy of the vault lives in a differently named folder.
PM_VAULT_NAME=
PM_NOTIFY_DAYS=14
PM_STALE_DAYS=14
# Optional email digest (projects.py notify) — sent only to this address, and
# only when something is overdue or due within PM_NOTIFY_DAYS.
PM_NOTIFY_TO=
# gmail-oauth | smtp | gmail-api (default: smtp if SMTP_PASSWORD is set, else gmail-oauth)
#   gmail-oauth: run `projects.py auth-gmail` once and sign in with your BUU
#   Google account. Uses the plugin's bundled OAuth client, or your own Desktop
#   client JSON if you save one as credentials.json beside this file (or point
#   PM_GMAIL_CLIENT at it). gmail-api: gcloud ADC (often blocked).
PM_MAIL_METHOD=gmail-oauth
# PM_GMAIL_CLIENT=~/.config/nk-work-kit/credentials.json
# Optional inbox scan (projects.py scan-inbox): Gmail Primary + Calendar → tasks
# in hub notes, via `claude -p`. Needs `projects.py auth-gmail --scan` once.
# Minimum confidence to add a task: high | medium | low.
PM_SCAN_MIN_CONFIDENCE=high
PM_SCAN_DAYS=14
PM_SCAN_MAX_MAIL=40
PM_SCAN_MODEL=sonnet
# PM_SCAN_CLAUDE=~/.local/bin/claude
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail: an app password, not your account password.
SMTP_PASSWORD=
